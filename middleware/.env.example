# =====================================================================
#  Middleware Alat Laboratorium — konfigurasi
#  Salin menjadi .env lalu sesuaikan.
# =====================================================================

# Alamat dasar LIS (tanpa garis miring di akhir).
# Sesuaikan bila LIS dipasang di sub-folder, mis. http://localhost/LIS/public
LIS_BASE_URL=http://localhost/LIS/public

# Kredensial API dengan cakupan "instrument". WAJIB DIISI.
#
# Sengaja dibiarkan kosong. Kunci bawaan skema
# (lis_mw_0000...) dinonaktifkan oleh bin/install.php sebagai langkah
# pengamanan, jadi mencantumkannya di sini hanya akan menghasilkan
# "API key tidak dikenali atau sudah dinonaktifkan" saat middleware start.
#
# Dua cara mengisinya:
#   a. Jalankan php bin/install.php — kunci ditulis ke .env secara otomatis
#   b. LIS → Pengaturan → Kredensial API → Terbitkan kredensial baru,
#      lalu salin kedua baris yang ditampilkan (hanya tampil sekali)
LIS_API_KEY=
LIS_API_SECRET=

# Kirim tanda tangan HMAC-SHA256 pada setiap permintaan (disarankan bila
# middleware dan LIS berada di mesin berbeda). Memerlukan kredensial yang
# dibuat lewat menu Kredensial API, bukan kredensial bawaan instalasi.
LIS_SIGN_REQUESTS=false

# Port HTTP untuk pemeriksaan kesehatan middleware (dipakai halaman Alat di LIS).
HEALTH_PORT=9701

# Interval denyut hidup ke LIS (detik).
HEARTBEAT_SECONDS=30

# Interval muat ulang konfigurasi alat dari LIS (detik).
CONFIG_REFRESH_SECONDS=300

# Interval pengambilan antrian worklist untuk alat dua arah (detik).
WORKLIST_POLL_SECONDS=20

# Bentuk jawaban worklist HL7: auto | orm | rsp | mindray | off
#
#   auto     mengikuti query alat — QBP^Q11 dijawab RSP^K11, QRY^Q02
#            dijawab ORM^O01.
#   orm      selalu ORM^O01
#   rsp      selalu RSP^K11
#   mindray  QCK^Q02 lalu DSR^Q03 berisi segmen DSP — dialek analyzer
#            Mindray (BC-5000, BC-5150, seri BS). WAJIB untuk alat Mindray:
#            ORM^O01 bukan pesan yang dikenalinya. Pada dialek ini kolom
#            "Kode Alat" pada Pemetaan Kode harus diisi NOMOR TES milik
#            analyzer, bukan singkatan seperti HGB.
#   off      JANGAN kirim worklist sama sekali; hanya balas ACK.
#
# BAWAANNYA "off", dan itu disengaja. Pesan order yang tidak dikenali tidak
# selalu menghasilkan kesalahan yang sopan — sebagian firmware langsung
# fault dan menuntut alat di-restart. Nyalakan hanya setelah dialek alat
# Anda dipastikan, di luar jam pelayanan, dengan satu sampel uji.
#
# Saat "off", hasil dari alat tetap mengalir normal ke LIS. Yang dimatikan
# hanya arah LIS → alat; order dimasukkan lewat layar analyzer.
# Pengaturan ini tidak memengaruhi ASTM.
HL7_WORKLIST_REPLY=off

# Tingkat log: error | warn | info | debug | trace
# Gunakan "trace" untuk melihat setiap byte yang dipertukarkan saat
# menelusuri masalah koneksi alat.
LOG_LEVEL=info

# Folder log dan spool (relatif terhadap folder middleware).
LOG_DIR=logs
SPOOL_DIR=spool

# Jeda sambung ulang untuk transport tcp_client dan serial (milidetik).
RECONNECT_DELAY_MS=5000

# Batas waktu diam sebuah sesi ASTM sebelum dianggap putus (milidetik).
ASTM_SESSION_TIMEOUT_MS=45000
